# Cross Platform Editor Configuration Manager - http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[{*.{yml,yaml},.markdownlint,.yamllint}]
indent_size = 2

[{Containerfile,Dockerfile,**.dockerfile}]
indent_size = 2

[*.json]
indent_size = 2

[{*.sh,*.bash}]
indent_size = 2

[{*.env,.env,.env.*}]
indent_size = 2
