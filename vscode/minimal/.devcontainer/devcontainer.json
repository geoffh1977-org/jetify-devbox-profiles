{
  "name": "Devbox",
  "dockerComposeFile": [
    "devbox.compose.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/Project",
  "remoteUser": "devbox",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "Devbox Shell",
        "terminal.integrated.profiles.linux": {
          "Devbox Shell": {
            "path": "/bin/bash",
            "args": [
              "-lc",
              "exec devbox shell"
            ]
          }
        }
      }
    }
  }
}
